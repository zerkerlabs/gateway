# Copy to deploy/.env and fill in. Nothing in here is a real secret — generate
# your own. `.env` is gitignored; keep it that way.

# ---- Postgres ---------------------------------------------------------------
POSTGRES_USER=zerker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=zerker
ROOMS_DB=rooms

# ---- Gateway ----------------------------------------------------------------
# Required. The gateway exits immediately without an issuer and audience — there
# is no unauthenticated path to bring it up. With `--profile dev-auth`, use:
#   ZERKER_OIDC_ISSUER=http://mock-oidc:9099
ZERKER_OIDC_ISSUER=https://your-idp.example.com
ZERKER_OIDC_AUDIENCE=zerker-gateway

# The JWT claim carrying the tenant. If this doesn't name a claim your tokens
# actually carry, every authenticated request 401s.
ZERKER_OIDC_TENANT_CLAIM=tenant

# The master key wrapping stored upstream credentials: 64 hex chars.
#   openssl rand -hex 32
# Losing it makes every stored credential undecryptable. Back it up somewhere
# that is not this file.
ZERKER_KMS_KEY=

GATEWAY_PORT=8080

# ---- Rooms (profile: rooms) -------------------------------------------------
ROOMS_OIDC_ISSUER=https://your-idp.example.com
ROOMS_OIDC_AUDIENCE=zerker-rooms
ROOMS_OIDC_TENANT_CLAIM=tenant
ROOMS_PORT=8090

# One Rooms deployment serves exactly one gateway tenant. Two tenants that each
# want Rooms means two Rooms + ZMem pairs.
ROOMS_GATEWAY_TENANT=acme

# A bearer token the gateway accepts for that tenant. Rooms sends it as-is and
# never refreshes it, so mint one with a long lifetime and rotate it yourself.
ROOMS_GATEWAY_CREDENTIAL=

# ---- ZMem sidecar (profile: rooms) ------------------------------------------
# Server configuration, never caller input: Rooms checks every response against
# its own configured tenant and refuses a mismatch.
ZMEM_TENANT_ID=tnt_demo
#   openssl rand -hex 32
ZMEM_SERVICE_TOKEN=

# ---- Images (optional) ------------------------------------------------------
# Unset, compose builds from this checkout. Set these to pull published images:
#   GATEWAY_IMAGE=ghcr.io/zerkerlabs/gateway:v0.1.0
#   ROOMS_IMAGE=ghcr.io/zerkerlabs/rooms:v0.1.0
#   ZMEM_IMAGE=ghcr.io/zerkerlabs/zmem-sidecar:0.1.12

# ---- console (profile: console) --------------------------------------------
# The operator console and its backend-for-frontend. The BFF holds the Gateway
# token server-side and proxies /api/* to the gateway, so the browser is never
# given a bearer. That only works if the console and the API share an origin —
# put both behind one hostname (see deploy/README.md).

# This console's public origin. The OIDC callback and logout URLs are built
# from it and must match the IdP registration exactly. It is deliberately not
# derived from request headers, so a proxy cannot change it.
CONSOLE_ORIGIN=https://console.example.com

# A confidential ("regular web application") client — it needs a secret.
# A public/SPA client will not work: the BFF authenticates to the token
# endpoint on the server side.
CONSOLE_OIDC_ISSUER=https://your-tenant.us.auth0.com/
CONSOLE_OIDC_CLIENT_ID=
CONSOLE_OIDC_CLIENT_SECRET=

# Callback to register at the IdP: ${CONSOLE_ORIGIN}/auth/callback
# Logout URL to register:          ${CONSOLE_ORIGIN}/
#
# The console requests `offline_access` so it can refresh without bouncing the
# operator through the IdP mid-task. Allow it on the API, or sessions end when
# the first access token expires.
#
# CONSOLE_OIDC_AUDIENCE defaults to ZERKER_OIDC_AUDIENCE above and must equal
# it: the gateway builds one verifier for one audience.

# DEV ONLY. Session cookies are Secure and __Host- prefixed; a browser rejects
# both over plain HTTP, so a localhost stack cannot complete a login without
# this. Never set it in front of real traffic.
# CONSOLE_COOKIE_INSECURE=true
